# Vite proxies /api to this origin when VITE_API_ORIGIN is unset (`npm run dev`).
# Copy to .env and change as needed. Not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:80

# If set, the browser calls this origin for /api/v1 (CORS required).
# `npm run dev-docker` sets this in the script.
# VITE_API_ORIGIN=http://127.0.0.1:80
