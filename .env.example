# Vite proxies /api to this origin when VITE_API_ORIGIN is unset (`npm run dev`).
# Copy to .env and change as needed. Not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:80

# If set, the browser calls this origin for /api/v1 (CORS required).
# VITE_API_ORIGIN=http://127.0.0.1:80

# Optional. `vite build` fetches the race list from here to write dist/sitemap.xml.
# Defaults to VITE_API_ORIGIN when that is an http(s) URL, otherwise https://api.speedhare.io.
# SITEMAP_API_ORIGIN=https://api.speedhare.io

# For production builds and `npm run deploy`, copy this file to .env.production
# (gitignored) and set:
# VITE_API_ORIGIN=https://api.speedhare.io
# S3_BUCKET=speedhare.io
# CLOUDFRONT_DISTRIBUTION_ID=E3E90CX64A9PDU
