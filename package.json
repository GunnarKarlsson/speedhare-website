{
  "name": "speedhare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hong Kong race analytics — results and performance data for road races",
  "homepage": "https://speedhare.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/GunnarKarlsson/speedhare-website.git"
  },
  "author": "Bahn Labs Ltd",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src eslint.config.mjs vite.config.ts vite.sitemap.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm audit --omit=dev --audit-level=high && npm run build",
    "s3:sync": "node scripts/run-aws.mjs s3-sync",
    "cf:invalidate": "node scripts/run-aws.mjs cf-invalidate",
    "deploy": "npm run build && npm run s3:sync && npm run cf:invalidate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
